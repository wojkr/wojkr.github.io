---
/*
 * Technology marquee (effect E7). No props. Data: `site.marquee`.
 * Uses the `.marquee` / `.marquee__track` utilities of motion.css.
 * The track holds four copies of the list: the loop moves by -50%, so each
 * half (two copies) must be wider than the viewport, also at 1920px and more.
 * Only the first copy is exposed to assistive technology.
 */
import { getEntry } from 'astro:content';

const site = (await getEntry('site', 'site'))!.data;
const items = site.marquee;
const hiddenCopies = [1, 2, 3];
---

<section class="tech-marquee" aria-label="Core technologies">
  <div class="marquee">
    <ul class="marquee__track" role="list">
      {items.map((item) => <li class="tech-marquee__item">{item}</li>)}
      {
        hiddenCopies.map(() =>
          items.map((item) => (
            <li class="tech-marquee__item" aria-hidden="true">
              {item}
            </li>
          )),
        )
      }
    </ul>
  </div>
</section>

<style>
  .tech-marquee {
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  /* Four copies make the track two times longer: keep the same speed. */
  .tech-marquee .marquee {
    --marquee-gap: var(--space-5);
    --marquee-duration: calc(var(--duration-marquee) * 2);
  }

  .tech-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    white-space: nowrap;
  }

  /* Small accent separator before each item. */
  .tech-marquee__item::before {
    content: '';
    flex: none;
    width: var(--space-2);
    height: var(--space-2);
    background-color: var(--color-accent);
    transform: rotate(45deg);
  }
</style>
